# Copy to .env.local. Points at the docker-compose.yml Postgres (local-only credentials).
DATABASE_URL=postgresql+psycopg://headroom:localdev@localhost:5432/headroom

# Sentry error reporting. Leave SENTRY_DSN empty to keep Sentry off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# Clerk (spec 10). CLERK_JWT_KEY is the instance's PEM public key (Clerk dashboard, API keys,
# "JWKS Public Key"), quoted, newlines kept. Required: the API will not start without it.
CLERK_JWT_KEY=
# Origins allowed in a token's azp claim, comma-separated. Empty: azp is not checked.
CLERK_AUTHORIZED_PARTIES=

# Plaid (spec 12). Sandbox keys only on your machine: Plaid dashboard, Developers, Keys.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox or production; no default.
PLAID_ENV=sandbox
# Public URL of POST /v1/webhooks/plaid, sent to Plaid on every link token. Leave empty locally:
# with no public URL, banks sync when they connect and from the nightly job.
PLAID_WEBHOOK_URL=
# Fernet keys for Plaid access tokens, comma-separated; the first encrypts, every key decrypts.
# Generate one: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=

# Forecasting method (spec 21): recurring_pattern (default) or rolling_average, the fallback.
FORECAST_STRATEGY=recurring_pattern

# Email (spec 28). console prints each email here; resend sends it (then RESEND_API_KEY is
# required). No default: a deploy that forgot it must not quietly print instead of sending.
EMAIL_SENDER=console
RESEND_API_KEY=
# From address on a domain verified in Resend. Resend's test sender works for local tries.
EMAIL_FROM="Headroom <onboarding@resend.dev>"
# Headroom's postal address, in every email's footer (CASL).
EMAIL_MAILING_ADDRESS="[MAILING ADDRESS]"
# Public base URLs: the web app (footer links) and this API (List-Unsubscribe header).
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
# Clerk Backend API secret key (Clerk dashboard, API keys): the API reads a recipient's
# address from Clerk when it sends. Same value as the web app's CLERK_SECRET_KEY.
CLERK_SECRET_KEY=

# PostHog and the weekly metrics report (spec 32). All optional. POSTHOG_APP_HOST is the
# region's app host (not the ingestion host the web app uses); the personal API key needs
# Query Read. Without recipients the Tuesday report is skipped.
POSTHOG_APP_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
METRICS_REPORT_RECIPIENTS=
