# Copy to .env.local. Never commit .env.local.

# Sentry, headroom-web project (spec 07). Leave the DSN empty to keep Sentry off.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Source map upload at build time. Optional: without a token the build skips the upload.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=headroom-web

# The API, called only from server code (spec 09). Playwright sets its own.
API_URL=http://localhost:8000

# Clerk development instance (spec 10). Never a production key here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Playwright only: the username of a Clerk test user with a first name, last name and email.
# Tests sign it in with a Clerk sign-in token, so no password is needed.
E2E_CLERK_USER_USERNAME=

# PostHog (spec 32): the project token, and the ingestion host of its region. Events are sent
# from the web server only. Leave POSTHOG_KEY empty to send none.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
